== generated/main/default/classes/GreetingService.cls ==
public class GreetingService {
    private static final String EMPTY_MESSAGE = 'Nobody to greet';

    public String LastGreeting {
        get;
        private set;
    }

    public static String greet(List<String> names) {
        if (names.isEmpty()) {
            Audit.write(EMPTY_MESSAGE);
            return EMPTY_MESSAGE;
        }
        String greeting = MessageFormatter.decorate(names[0]);
        Audit.write(greeting);
        return greeting;
    }
}
