                return email;
            }
            else {
                String reason = ZenithGenerated_match_5_358.ZenithGenerated_v1_p0;
                return reason;
            }
        }
    }

    public static String narrowed(OwnerContact owner) {
        if (owner == null) {
            return 'none';
        }
        return owner.email;
    }
}
