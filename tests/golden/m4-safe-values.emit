public class SafeValueService {
    public static LookupResult found(Id requested, OwnerContact owner) {
        AccountSummary summary = new AccountSummary(requested, owner);
        return LookupResult.Found(summary);
    }

    public static String describe(Id requested, LookupResult result) {
